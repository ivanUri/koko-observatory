    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
